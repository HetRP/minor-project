# VulnExplain Configuration
# Copy this file to .env and fill in your values.

# LLM Providers (Groq Free Tier)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace Inference API (Free Fallback)
# Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here
HF_INFERENCE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Local Model & Checkpoints Directory
MODEL_CHECKPOINT_DIR=model/checkpoints/best

# Application Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_PATH=vulnexplain.db
MAX_INGEST_FILES=500
MAX_FILE_SIZE_KB=200
VITE_API_URL=http://localhost:8000
